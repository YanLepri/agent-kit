{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": [
    "cursor",
    "claudecode"
  ],
  "features": [
    "rules",
    "mcp",
    "subagents",
    "skills"
  ],
  "delete": false,
  "verbose": false,
  "silent": false,
  "global": true,
  "simulateCommands": false,
  "simulateSubagents": false,
  "simulateSkills": false,
  "gitignoreTargetsOnly": true,
  "sources": [
    {
      "source": "https://github.com/ar27111994/penpot-mcp.git",
      "skills": [
        "penpot-mcp"
      ],
      "transport": "git",
      "path": "."
    },
    {
      "source": "https://github.com/ciembor/agent-rules-books.git",
